  align-items:center;
  gap:14px;
}
.avatar{
  width:58px;
  height:58px;
  border-radius:50%;
  background:#edf3ff;
  display:grid;
  place-items:center;
  font-size:27px;
}
.player h3{margin:0 0 4px}
.player p{
  margin:0;
  color:#667085;
}

.badge{
