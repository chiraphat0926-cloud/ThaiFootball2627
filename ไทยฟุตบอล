  if (tab) tab.classList.add("active");

  const names={
    t1:"ไทยลีก 1",
    t2:"ไทยลีก 2",
    t3:"ไทยลีก 3"
  };

  const descriptions={
    t1:"BYD SEALION 6 LEAGUE 1 · 2026/27",
    t2:"BYD SEAL 5 LEAGUE 2 · 2026/27",
    t3:"BYD DOLPHIN LEAGUE 3 · 2026/27"
  };

  document.getElementById("league-name").innerText = names[type] || "ลีก";
  document.getElementById("league-description").innerText = descriptions[type] || "";

  renderStandings(type);

}


/* =========================
   STANDINGS
   Using mapping:
   [ name, played, wins, draws, losses, goalsFor, goalsAgainst, points ]
========================= */

function renderStandings(type){

  const body=document.getElementById("standings");
  if (!body) return;

  body.innerHTML="";

  const list = standingsData[type] || [];

  list.forEach((team,index)=>{

    const row=document.createElement("tr");

    // Defensive: ensure indices exist
    const played = team[1] ?? 0;
    const wins = team[2] ?? 0;
    const draws = team[3] ?? 0;
    const losses = team[4] ?? 0;
    const gf = team[5] ?? 0;
    const ga = team[6] ?? 0;
    const points = team[7] ?? 0;

    row.innerHTML=`
      <td>${index+1}</td>
      <td><strong>${team[0] ?? ' - '}</strong></td>
      <td>${played}</td>
      <td>${wins}</td>
      <td>${draws}</td>
      <td>${losses}</td>
      <td>${gf}</td>
      <td>${ga}</td>
      <td><strong>${points}</strong></td>
    `;

    body.appendChild(row);

  });

}


/* =========================
   FIXTURES
========================= */

function renderFixtures(){

  const box=document.getElementById("fixtures");
  if (!box) return;

  box.innerHTML="";

  fixturesData.forEach(game=>{

    const div=document.createElement("div");
    div.className="match";

    div.innerHTML=`
      <div class="team">
        <strong>${game[2]}</strong>
        <small>${game[0]} · ${game[1]}</small>
      </div>

      <div class="vs">VS</div>

      <div class="team away">
        <strong>${game[3]}</strong>
      </div>
    `;

    box.appendChild(div);

  });

}


/* =========================
   PLAYERS
========================= */

function renderPlayers(list = playersData){

  const box=document.getElementById("players");
  if (!box) return;

  box.innerHTML="";

  if (!list || list.length === 0) {
    const empty = document.createElement("div");
    empty.className = "card";
    empty.innerHTML = `<p>ไม่พบนักเตะที่ตรงกับการค้นหา</p>`;
    box.appendChild(empty);
    return;
  }

  const frag = document.createDocumentFragment();

  list.forEach(player=>{

    const div=document.createElement("article");
    div.className="card player";

    div.innerHTML=`
      <div class="avatar" aria-hidden="true">🇹🇭</div>

      <div>
        <h3>${player.name}</h3>
        <p>${player.position}</p>
        <small>${player.club}</small>
      </div>
    `;

    frag.appendChild(div);

  });

  box.appendChild(frag);

}

function searchPlayers(){

  const input = document.getElementById("playerSearch");
  if (!input) return;

  const query = input.value.trim().toLowerCase();

  if (query === "") {
    renderPlayers(playersData);
    return;
  }

  const result = playersData.filter(player=>
    (player.name+" "+player.position+" "+player.club).toLowerCase().includes(query)
  );

  renderPlayers(result);

}


/* =========================
   START
========================= */

renderFixtures();
renderPlayers();
openLeague("t1");
showPage("home");

</script>

