<title>ไทยฟุตบอล 26/27</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,"Noto Sans Thai",sans-serif;
  background:#f3f6fb;
  color:#172033;
}
button,input{font:inherit}
button{cursor:pointer}

.header{
  position:sticky;
  top:0;
  z-index:20;
  background:#071a52;
  color:white;
  padding:14px 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  box-shadow:0 4px 18px #0003;
}
.logo{
  display:flex;
  align-items:center;
  gap:10px;
  cursor:pointer;
}
.logo-ball{font-size:35px}
.logo h1{font-size:20px;margin:0}
.logo small{color:#ffcc29;font-weight:bold}

.nav{
  display:flex;
  gap:5px;
}
.nav button{
  border:0;
  background:transparent;
  color:#dbe5ff;
  padding:9px 12px;
  border-radius:9px;
}
.nav button:hover,.nav button.active{
  background:#183476;
  color:white;
}

.container{
  width:min(1120px,94%);
  margin:25px auto 70px;
}

.hero{
  min-height:390px;
  border-radius:28px;
  padding:40px;
  color:white;
  background:
    radial-gradient(circle at 85% 20%,#3156b5,transparent 28%),
    linear-gradient(120deg,#071a52,#123c9a);
  display:flex;
  align-items:center;
  justify-content:space-between;
  overflow:hidden;
}
.hero h2{
  font-size:clamp(38px,7vw,70px);
  line-height:1.05;
  margin:8px 0 18px;
}
.hero p{
  max-width:560px;
  color:#d9e4ff;
  line-height:1.7;
}
.hero-ball{
  font-size:180px;
  filter:drop-shadow(0 20px 20px #0005);
}
.tag{
  color:#ffcc29;
  font-weight:900;
  letter-spacing:2px;
}
.red{color:#e21b2d}

.primary{
  border:0;
  border-radius:12px;
  padding:13px 22px;
  background:#e21b2d;
  color:white;
  font-weight:bold;
}

.title{
  margin:35px 0 16px;
  font-size:26px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}
.card{
  background:white;
  border-radius:18px;
  padding:22px;
  box-shadow:0 5px 20px #14224b12;
}

.league{
  color:white;
  min-height:145px;
  border:0;
  text-align:left;
  position:relative;
  overflow:hidden;
}
.league:after{
  content:"⚽";
  position:absolute;
  right:-10px;
  bottom:-35px;
  font-size:100px;
  opacity:.14;
}
.t1{background:#e21b2d}
.t2{background:#1464d2}
.t3{background:#159447}

.league small,.league strong,.league span{
  display:block;
}
.league strong{
  font-size:25px;
  margin:8px 0;
}

.news{
  overflow:hidden;
  padding:0;
}
.news-img{
  height:130px;
  display:grid;
  place-items:center;
  font-size:55px;
  background:linear-gradient(135deg,#071a52,#e21b2d);
}
.news-body{padding:18px}
.news-body h3{margin:8px 0}
.news-body small{color:#667085}

.page-title{
  margin:15px 0 25px;
}
.page-title h2{
  margin:0;
  font-size:36px;
}

.tabs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  margin-bottom:18px;
}
.tabs button{
  border:1px solid #d9dfeb;
  background:white;
  padding:11px 17px;
  border-radius:10px;
  white-space:nowrap;
}
.tabs button.active{
  background:#071a52;
  color:white;
}

.panel{
  background:white;
  border-radius:20px;
  padding:24px;
  box-shadow:0 5px 20px #14224b10;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin:18px 0;
}
.stat{
  background:#f4f6fa;
  border-radius:13px;
  padding:17px;
}
.stat strong,.stat span{display:block}
.stat span{
  color:#667085;
  margin-top:5px;
  font-size:14px;
}

.table-wrap{overflow-x:auto}
table{
  width:100%;
  border-collapse:collapse;
}
th,td{
  padding:13px 10px;
  border-bottom:1px solid #edf0f5;
  text-align:left;
  white-space:nowrap;
}
th{
  color:#667085;
  font-size:13px;
}

.match{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:17px;
  border-bottom:1px solid #edf0f5;
}
.match:last-child{border-bottom:0}
.team{
  width:40%;
}
.team.away{text-align:right}
.vs{
  font-weight:900;
  color:#e21b2d;
}

.search{
